---
import { formatearFechaCorta, formatearMonto } from '../lib/format';
import IconoCategoria from './IconoCategoria.astro';
import type { Gasto } from '../lib/types';

interface Props {
	gasto: Gasto;
	enlazable?: boolean;
	mesCerrado?: boolean;
}

const { gasto, enlazable = true, mesCerrado = false } = Astro.props;

// Si el mes está cerrado, el gasto nunca debe ser enlazable (no editable),
// sin importar lo que se haya pasado en `enlazable`.
const esEnlazable = mesCerrado ? false : enlazable;

const etiquetaPagador: Record<string, string> = {
	meman: 'Meman',
	paya: 'Paya',
	conjunto: 'Conjunto',
};
---

<a
	href={esEnlazable ? `/gastos/${gasto.id}/editar?mes=${gasto.mes_referencia}` : undefined}
	class:list={['gasto', { 'no-enlace': !esEnlazable, 'mes-cerrado': mesCerrado }]}
	aria-disabled={mesCerrado ? 'true' : undefined}
	title={mesCerrado ? 'Mes cerrado: no se puede editar' : undefined}
>
	<IconoCategoria icono={gasto.icono} color={gasto.color} />
	<div class="info">
		<p class="descripcion">{gasto.descripcion}</p>
		<p class="meta texto-muted">
			{formatearFechaCorta(gasto.fecha)} · {etiquetaPagador[gasto.pagado_por]}
		</p>
	</div>
	<span class="monto">{formatearMonto(gasto.monto)}</span>
	{
		mesCerrado && (
			<svg
				class="icono-candado"
				width="14"
				height="14"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
				<path d="M7 11V7a5 5 0 0 1 10 0v4" />
			</svg>
		)
	}
</a>

<style>
	/* Layout tipo historial bancario: ícono fijo a la izquierda, info
	   (descripción + fecha) apilada y flexible al centro, monto anclado
	   a la derecha sin encogerse nunca. */
	.gasto {
		display: flex;
		align-items: center;
		gap: var(--espacio-3);
		padding: var(--espacio-2) 0;
		text-decoration: none;
		color: var(--color-text);
	}

	.gasto > :global(*:first-child) {
		flex: 0 0 auto;
	}

	.gasto.no-enlace {
		pointer-events: none;
	}

	.gasto.mes-cerrado {
		opacity: 0.6;
	}

	@media (hover: hover) {
		.gasto {
			border-radius: var(--radio-chico);
			margin: 0 calc(-1 * var(--espacio-2));
			padding: var(--espacio-2);
			transition: background-color 0.15s ease;
		}

		.gasto:not(.no-enlace):hover {
			background: var(--color-bg-elevated-2);
		}
	}

	.info {
		flex: 1 1 auto;
		min-width: 0;
		display: flex;
		flex-direction: column;
	}

	.descripcion {
		margin: 0;
		font-weight: 600;
		font-size: 0.92rem;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.meta {
		margin: 2px 0 0;
		font-size: 0.75rem;
	}

	.monto {
		flex: 0 0 auto;
		font-weight: 800;
		font-size: 0.95rem;
		white-space: nowrap;
		margin-left: auto;
	}

	.icono-candado {
		flex: 0 0 auto;
		color: var(--color-text-muted);
	}
</style>
