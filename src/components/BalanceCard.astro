---
import { formatearMonto } from '../lib/format';
import type { Balance } from '../lib/types';

interface Props {
	balance: Balance;
}

const { balance } = Astro.props;
const { diferencia_meman, pagado_meman, pagado_paya, total_gastado } = balance;

const aPaz = Math.round(diferencia_meman) === 0;
const pagaPaya = diferencia_meman > 0;
const monto = Math.abs(diferencia_meman);
---

<div class="tarjeta-balance">
	<div class="brillo" aria-hidden="true"></div>

	<p class="etiqueta">Balance del mes</p>

	{
		aPaz ? (
			<p class="frase-paz">Están a paz y salvo ✓</p>
		) : (
			<>
				<p class="monto-grande">{formatearMonto(monto)}</p>
				<p class="frase">
					{pagaPaya ? 'Paya le debe a Meman' : 'Meman le debe a Paya'}
				</p>
			</>
		)
	}

	<div class="totales">
		<div>
			<span>Meman pagó</span>
			<strong>{formatearMonto(pagado_meman)}</strong>
		</div>
		<div>
			<span>Paya pagó</span>
			<strong>{formatearMonto(pagado_paya)}</strong>
		</div>
		<div>
			<span>Total del mes</span>
			<strong>{formatearMonto(total_gastado)}</strong>
		</div>
	</div>
</div>

<style>
	/* Widget tipo tarjeta de credito: gradiente oscuro fijo (no depende del
	   tema claro/oscuro, igual que una tarjeta fisica), con texto claro. */
	.tarjeta-balance {
		position: relative;
		overflow: hidden;
		text-align: center;
		border-radius: var(--radio);
		padding: var(--espacio-5) var(--espacio-4) var(--espacio-4);
		background: linear-gradient(155deg, color-mix(in srgb, var(--color-accent) 55%, #0a0f0c) 0%, #14110f 55%, #0b0a09 100%);
		color: #f7f4ef;
		box-shadow: var(--sombra);
		border: 1px solid rgba(255, 255, 255, 0.08);
	}

	/* Reflejo sutil, como el brillo de una tarjeta fisica bajo la luz. */
	.brillo {
		position: absolute;
		inset: -40% -20% auto auto;
		width: 60%;
		height: 140%;
		background: radial-gradient(closest-side, color-mix(in srgb, var(--color-accent) 45%, transparent), transparent 70%);
		opacity: 0.5;
		pointer-events: none;
	}

	.etiqueta {
		position: relative;
		font-size: 0.78rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		margin-bottom: var(--espacio-2);
		color: rgba(247, 244, 239, 0.65);
	}

	.monto-grande {
		position: relative;
		font-size: 3.2rem;
		font-weight: 800;
		margin: 0;
		letter-spacing: -0.03em;
		line-height: 1.05;
	}

	.frase {
		position: relative;
		margin: 6px 0 var(--espacio-5);
		color: rgba(247, 244, 239, 0.7);
		font-weight: 500;
	}

	.frase-paz {
		position: relative;
		margin: var(--espacio-2) 0 var(--espacio-5);
		font-size: 1.4rem;
		font-weight: 700;
	}

	.totales {
		position: relative;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--espacio-2);
		border-top: 1px solid rgba(255, 255, 255, 0.14);
		padding-top: var(--espacio-3);
	}

	.totales div {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.totales span {
		font-size: 0.72rem;
		color: rgba(247, 244, 239, 0.6);
	}

	.totales strong {
		font-size: 1rem;
		font-weight: 700;
	}
</style>
